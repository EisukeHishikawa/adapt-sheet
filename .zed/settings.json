// Zedのプロジェクト設定（ADR-024）。リンター/フォーマッターはホストへ入れず、
// 開発用Dockerイメージ内のruff / BiomeをLSPとして起動する（scripts/zed-lsp.sh 経由）。
//
// binary.pathは絶対パスで指定する必要がある。クローン先が異なる環境では
// `scripts/setup-zed.sh` を実行すると、このファイルのパスを自分のリポジトリルートへ書き換える。
{
  "lsp": {
    // backendイメージのruff（backend/requirements.txt でバージョン固定）。
    "ruff": {
      "binary": {
        "path": "/Users/mina/adapt-sheet/scripts/zed-lsp.sh",
        "arguments": ["ruff"]
      }
    },
    // frontend/Dockerfile.lsp の biome lsp-proxy。
    // リント・整形規則はfrontend/biome.jsonがそのまま使われる。
    "biome": {
      "binary": {
        "path": "/Users/mina/adapt-sheet/scripts/zed-lsp.sh",
        "arguments": ["biome"]
      }
    }
  },

  "languages": {
    "Python": {
      // ホストにPython環境を用意しない方針のため、型チェッカー（pyright等）は起動せず
      // `ruff check` 相当の診断だけをDocker内のruffから受け取る。
      "language_servers": ["ruff", "!pyright", "!basedpyright", "!pylsp", "!ty", "!pyrefly"],
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      // 整形幅（line-length = 120）は各サービスのruff.tomlが一次ソースで、CIも
      // `ruff format --check`で同じ設定を見る。
      "format_on_save": "on"
    },

    // 整形・リント・import整列はすべてBiomeが担う。Zed同梱のPrettierはリポジトリが
    // バージョンを固定できないため明示的に無効化する。
    "TypeScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },
    "TSX": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },
    "JavaScript": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    },
    // CSSもBiomeの検査対象（frontend/biome.jsonのincludesが`**`）のため、エディタ側も
    // Biomeへ揃える。Zed既定のPrettierに任せると整形結果がCIと食い違う。
    // JSONはリポジトリ直下（.zed/settings.json等）がBiomeの設定範囲外のため、対象にしない。
    "CSS": {
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      }
    }
  }
}
