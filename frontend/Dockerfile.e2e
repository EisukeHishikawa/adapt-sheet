# E2E（Playwright）専用イメージ。Playwright公式はAlpine/musl libcに非対応のため、
# 軽量なfrontend/Dockerfile（node:20-alpine）とは別にglibc環境を用意する。
# タグはpackage-lock.jsonの@playwright/testバージョンと完全一致させること（ずれると起動時にエラーになる）。
FROM mcr.microsoft.com/playwright:v1.61.1-jammy

WORKDIR /app

# frontendサービス（Vite開発サーバー）の起動待ちポーリングに使う。
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# 依存関係の定義ファイルだけ先にコピーし、Dockerのレイヤーキャッシュを効かせる（frontend/Dockerfileと同様）。
COPY package.json package-lock.json .npmrc ./
RUN npm install

COPY . .

# depends_onはコンテナの起動順序のみを保証し、Viteサーバーの準備完了までは待たないため、
# frontendサービスへの疎通が確認できるまでポーリングしてからテストを実行する。
CMD ["sh", "-c", "until curl -sf http://frontend:5173/ -o /dev/null; do sleep 1; done; npx playwright test"]
